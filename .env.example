# ==============================================================================
# জাতীয় মাদ্রাসা ম্যানেজমেন্ট প্ল্যাটফর্ম (SaaS ERP)
# Environment Configuration Template (.env.example)
# IMPORTANT: NEVER commit real passwords, keys, or secrets to version control.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000

# Base URLs
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000,http://127.0.0.1:5173

# PostgreSQL Database Configuration
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://madrasha_admin:madrasha_secure_pass_2026@localhost:5432/madrasha_control
DATABASE_MAX_CONNECTIONS=20

# Redis Cache & BullMQ Queue Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass_2026
REDIS_URL=redis://:redis_secure_pass_2026@localhost:6379

# JWT Authentication (RS256 recommended or HS256 for local dev)
JWT_SECRET=super_secret_jwt_random_key_min_32_characters_long_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Two-Factor Authentication (TOTP)
TOTP_APP_NAME="Madrasha SaaS"

# Application Field-Level Encryption Key (AES-256-GCM: 32 bytes hex)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# SMS Gateway Integration (BulkSMSBD / SSL Wireless)
SMS_PROVIDER=bulksmsbd
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=MADRASHA
SMS_API_URL=http://bulksmsbd.net/api/smsapi

# Payment Gateway Configurations (Sandbox / Live)
# SSLCommerz
SSLCOMMERZ_STORE_ID=test_store_id
SSLCOMMERZ_STORE_PASS=test_store_pass
SSLCOMMERZ_IS_SANDBOX=true

# bKash PGW
BKASH_APP_KEY=test_bkash_app_key
BKASH_APP_SECRET=test_bkash_app_secret
BKASH_USERNAME=test_bkash_username
BKASH_PASSWORD=test_bkash_password
BKASH_IS_SANDBOX=true

# Nagad
NAGAD_MERCHANT_ID=test_nagad_merchant
NAGAD_PUBLIC_KEY=test_nagad_public_key
NAGAD_PRIVATE_KEY=test_nagad_private_key
NAGAD_IS_SANDBOX=true

# Push Notifications (Firebase Cloud Messaging)
FIREBASE_PROJECT_ID=madrasha-management-saas
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@madrasha.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Object Storage (S3 / Backblaze B2 compatible)
STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
STORAGE_BUCKET=madrasha-platform-files
STORAGE_ACCESS_KEY=your_storage_access_key
STORAGE_SECRET_KEY=your_storage_secret_key
STORAGE_REGION=us-west-004

# Database Automated Backup Settings
BACKUP_ENCRYPTION_KEY=backup_secret_encryption_key_32_bytes_2026
BACKUP_RETENTION_DAYS=30

# System Timezone
TZ=Asia/Dhaka
